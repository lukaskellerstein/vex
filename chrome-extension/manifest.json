{
  "manifest_version": 3,
  "name": "Vex",
  "version": "3.3.0",
  "description": "Visually select elements on any webpage, annotate them with instructions, and send to a coding agent for automatic code changes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8420/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "screenshot-viewer.html",
        "screenshot-viewer.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}