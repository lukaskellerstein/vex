{
  "name": "vex-desktop",
  "version": "0.1.0",
  "description": "Vex desktop application",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron --no-sandbox --remote-debugging-port=9222 dist/main/index.js",
    "build:start": "npm run build && npm run start"
  },
  "build": {
    "appId": "com.vex.desktop",
    "productName": "Vex",
    "icon": "resources/icon.png",
    "linux": {
      "icon": "resources/icon.png"
    },
    "mac": {
      "icon": "resources/icon.png"
    },
    "win": {
      "icon": "resources/icon.png"
    }
  },
  "dependencies": {
    "electron": "^30.0.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.7.0",
    "nats.ws": "^1.30.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.13.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
